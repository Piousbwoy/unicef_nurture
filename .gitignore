# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# District sync server (server/)
server/node_modules/
# .env holds the DB password and sync bearer token — never commit it.
server/.env

# Persistent Chrome profile used by the web debug run (.vscode/launch.json).
# Contains the app's browser-side database — never commit it.
.chrome-profile/

# ONNX weights are tracked as plain git blobs (see .gitattributes). Every model
# in assets/ is quantized to stay under GitHub's 100 MB per-file limit, so the
# LFS quota is no longer on the critical path. Regenerate them with
# tool/quantize_translation_models.py; do not re-add ignore rules for *.onnx.

# Vendored ONNX Runtime WASM (10.7 MB), regenerable with tool/fetch_ort_web.py.
web/voice_runtime/

# Agent debug screenshots from Flutter web verification runs.
.qoder_screens/

# Track B training corpora: licensed audio pulled by tool/track_b/fetch_dagbani.py.
# Hundreds of MB of third-party recordings; never a repo artifact.
/data/

# Verification scratch from a working session: `flutter analyze`, `flutter test` and
# `git diff` captures written beside the repo so a long command's output could be
# read back reliably. They are evidence for one conversation, not a build artefact.
# Two of them (.chk_final.txt, .chk_spine.txt) are ~340 KB of log text and were
# committed once by accident — which is why the patterns are spelled out rather than
# left to *.log, which these are not.
/.audit_*
/.chk_*
/.d_*
/.final*
/.f[0-9].txt
/.full*
/.g[0-9].txt
/.git_*
/.ver*
/.qoder/cg_diff.txt

# Throwaway ASR measurement downloads (473 MB of eval audio + HF cache)
/tool/asr_eval/data/
/tool/asr_eval/out/
/tool/asr_eval/__pycache__/
node_modules
