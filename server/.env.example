# ============================================================================
# CareBridge sync server configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- MariaDB connection -----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=carebridge_sync
DB_PASSWORD=change-me-strong-password
DB_NAME=carebridge

# --- Sync API ---------------------------------------------------------------
# Port the API listens on. The phone's sync URL will be http://<this-machine>:3000
PORT=3000

# ---- Legacy global sync token (deprecation window) -------------------------
# This is kept ONLY for the brief transition window while phones update to the
# new per-user JWT auth. Once all devices are on the post-P0 client, REMOVE
# this token entirely from the server config. A shared token for every device
# is a data-governance risk.
SYNC_API_TOKEN=change-me-to-a-long-random-token

# ---- JWT authentication ----------------------------------------------------
# Issuer/audience labels baked into every token.
JWT_ISSUER=carebridge-sync
JWT_AUDIENCE=carebridge-clients

# Short-lived access tokens, signed with this key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-hex-secret

# Long-lived refresh tokens, signed with a DIFFERENT key. Same generator.
JWT_REFRESH_SECRET=change-me-to-a-different-64-char-random-hex-secret

# Token lifetimes, in minutes.
JWT_ACCESS_TTL_MINUTES=720
JWT_REFRESH_TTL_DAYS=30

# ---- Recovery authorization ------------------------------------------------
# A phone_number + PIN attempt window. More than MAX_ATTEMPTS in WINDOW_SECONDS
# locks further attempts for LOCK_SECONDS — slows offline PIN-hash crack rates.
AUTH_RATE_MAX_ATTEMPTS=10
AUTH_RATE_WINDOW_SECONDS=60
AUTH_RATE_LOCK_SECONDS=300
