# ============================================================================
# CareBridge sync server configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- MariaDB connection -----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=carebridge_sync
DB_PASSWORD=change-me-strong-password
DB_NAME=carebridge

# --- Sync API ---------------------------------------------------------------
# Port the API listens on. The phone's sync URL will be http://<this-machine>:3000
PORT=3000

# Bearer token every phone must present. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value in each phone's Sync settings -> API token.
SYNC_API_TOKEN=change-me-to-a-long-random-token
